# ---------------------------------------------------------------------------
# VAuLT LMS Gateway - LTI 1.3. Copy to .env (never commit .env).
# There is NO shared secret in LTI 1.3: trust comes from Canvas's signed id_token.
# ---------------------------------------------------------------------------

# Port for the Gateway service
PORT=3000

# Public HTTPS URL of this Gateway, exactly as Canvas will reach it (cloudflared/ngrok/prod domain).
# Every LTI URL (login, launch, jwks, config.json, QR deep link) is built from this value.
GATEWAY_PUBLIC_URL=https://your-gateway.example.com

# VAuLT Backend API URL (port 80)
VAULT_API_URL=http://localhost:80

# Where experience mappings, short-lived launch sessions, login state and the tool key pair are stored
# (mount a volume here). Nothing in it is a name, email, title or score.
DATA_DIR=./data

# --- Vii (VAuLT backend) server-to-server ---
# Same value as GATEWAY_API_KEY on the Vii server (sent as X-Gateway-Key). At least 32 random characters.
VII_GATEWAY_KEY=
# Same value as GATEWAY_HOOK_SECRET on the Vii server (verifies X-Vii-Signature). At least 32 random characters.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VII_HOOK_SECRET=
# Vii must be told where to send hooks:  GATEWAY_HOOK_URL=<GATEWAY_PUBLIC_URL>/api/hooks/vii/attempt

# --- Canvas platform registration (from the Canvas Developer Key / "Details" page) ---
# Issuer: the `iss` Canvas puts in its id_token. Canvas Cloud: https://canvas.instructure.com
# Self-hosted Canvas: confirm by decoding a real id_token (a mismatch is logged as "iss: ..." on launch).
LTI_ISSUER=https://canvas.instructure.com
# Developer Key "Client ID" (the number shown in the key list)
LTI_CLIENT_ID=
# Deployment ID (Canvas: Settings > Apps > App Configurations > the tool's gear > Deployment Id). REQUIRED.
LTI_DEPLOYMENT_ID=
# Canvas Cloud endpoints. For self-hosted Canvas use https://<your-canvas-host>/... with the same paths.
LTI_AUTH_LOGIN_URL=https://sso.canvaslms.com/api/lti/authorize_redirect
LTI_AUTH_TOKEN_URL=https://sso.canvaslms.com/login/oauth2/token
LTI_JWKS_URL=https://sso.canvaslms.com/api/lti/security/jwks
# Only if Canvas requires a different `aud` for the token request than the token URL above
# LTI_TOKEN_AUDIENCE=

# --- Tool key pair (optional) ---
# Leave unset: a key is generated once into DATA_DIR/keys. To supply your own, paste a PKCS#8 PEM with \n for newlines.
# LTI_PRIVATE_KEY=
LTI_KEY_ID=vault-lti-key-1

# --- Grades ---
# How each attempt's readable work reaches Canvas: text (new text submission, default), comment, none
# SUBMISSION_FORMAT=text
# Keep a grade the instructor set by hand (Canvas prioritize_non_tool_grade). Default true.
# PRESERVE_INSTRUCTOR_GRADE=true
# Points possible of the gradebook column created through Deep Linking
# DEFAULT_POINTS_POSSIBLE=100

# --- Optional hardening ---
# Extra origins allowed to embed the pages in an iframe (default already allows Canvas + registered issuer)
# FRAME_ANCESTORS=https://canvas.example.edu
# Cross-origin browser callers of /api (default: none)
# CORS_ORIGINS=
# SESSION_TTL_HOURS=24
# LAUNCH_CODE_TTL_SEC=600
# DEEP_LINK_TTL_SEC=600
# LOGIN_STATE_TTL_SEC=600
# VII_CATALOG_CACHE_SEC=60
# LTI_CLOCK_TOLERANCE_SEC=10
# LTI_MAX_TOKEN_AGE_SEC=300
